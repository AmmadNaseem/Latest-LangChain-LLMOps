# Merge into your existing .env. Never commit real keys.
GROQ_API_KEY=replace-with-your-groq-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2
GROQ_MAX_TOKENS=1024
API_HOST=127.0.0.1
API_PORT=8000
AGENT_MAX_STEPS=6
TAVILY_API_KEY=replace-with-your-tavily-key
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=groq-learning-demos
# Set the endpoint matching your account region when enabling tracing.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
